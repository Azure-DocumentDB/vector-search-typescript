{
  "name": "vector-search-typescript",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/cli.js",
    "test:live": "node dist/cli.js --live",
    "query-vector": "node dist/query-vector.js",
    "data:fetch": "node dist/fetch-data.js",
    "start:ivf": "node dist/cli.js --algorithm ivf",
    "start:hnsw": "node dist/cli.js --algorithm hnsw",
    "start:diskann": "node dist/cli.js --algorithm diskann"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "mongodb": "7.7.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
