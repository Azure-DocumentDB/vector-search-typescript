# Reference only. Programs read process environment; no automatic dotenv.
# Inject native passwords/URIs securely, never commit a populated file.
MONGO_AUTH_MODE=oidc
MONGO_HOST=<approved-cluster>.global.mongocluster.cosmos.azure.com
MONGO_DATABASE=vectorsearch_disposable_<unique_lowercase_run_id>
MONGO_COLLECTION_PREFIX=oidc
VECTOR_SEARCH_ALLOW_WRITES=false
DATA_FILE_WITH_VECTORS=data/Hotels_Vector.json
QUERY_VECTOR_FILE=data/query-vector.json
EMBEDDING_DIMENSIONS=1536
LOAD_SIZE_BATCH=50
TOP_K=5
VECTOR_SEARCH_CASE_TIMEOUT_MS=120000
# Explicit live gate requires LIVE_AZURE_TEST=true (never set by CI).
# Native alternative: MONGO_AUTH_MODE=connection-string and securely injected
# MONGO_CONNECTION_STRING. Unset it for OIDC; no authentication fallback.
